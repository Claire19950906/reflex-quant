# =============================================================
# Trident v300 — 环境变量模板
# =============================================================
# 用法：cp backend/.env.example backend/.env，然后填入真实值。
# 切勿把 .env 提交到 Git（.gitignore 已忽略）。
# =============================================================

# ───── 1. 运行模式（v300 新增） ─────────────────────────────
# full    = 开发者本地全功能模式（默认）
# demo    = 公开/朋友体验模式：限流 + 脱敏 + 水印 + 审计
# licensed= 受邀请用户体验：full + License + API Key
TRIDENT_MODE=full

# full 模式下的监听地址（默认 127.0.0.1；改成 0.0.0.0 会启动告警）
TRIDENT_LISTEN_HOST=127.0.0.1
TRIDENT_LISTEN_PORT=8000

# ───── 2. 体验模式（demo）参数 ─────────────────────────────
TRIDENT_DEMO_RPM=30                   # 每 IP 每 60s 最多 30 次
TRIDENT_DEMO_DAILY_BUDGET=5000        # 每 IP 每天最多 5000 次
TRIDENT_DEMO_DELAY_MS=200             # 注入 200ms 延迟
TRIDENT_DEMO_JITTER_MS=80             # ±80ms 抖动
TRIDENT_DEMO_HISTORY_DAYS=1           # 历史窗口
TRIDENT_DEMO_DECIMALS=2               # 数值截位
TRIDENT_DEMO_TOKEN_BUDGET=100000      # 全局每日 token 上限

# ───── 3. 鉴权（licensed 模式必填） ────────────────────────
# 32 字节随机；漏设 = load_license 直接返回 None（fail-closed）
TRIDENT_LICENSE_SECRET=__SET_ME__
TRIDENT_LICENSE_FILE=/etc/trident/license.lic
TRIDENT_API_KEY_STORE=/etc/trident/api_keys.json

# licensed 模式覆盖默认值（更宽松）：
# TRIDENT_DEMO_RPM=120
# TRIDENT_DEMO_DAILY_BUDGET=50000
# TRIDENT_DEMO_HISTORY_DAYS=7
# TRIDENT_DEMO_DECIMALS=4

# ───── 4. 审计（demo / licensed 模式启用） ──────────────────
TRIDENT_AUDIT_DB=/var/lib/trident/trident_audit.db

# ───── 5. 业务侧原有变量（保持兼容） ────────────────────────
# LLM（OpenRouter / Kimi）
OPENROUTER_API_KEY=__SET_ME__
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TRIDENT_LLM_MODEL=moonshotai/kimi-k2

# 数据源
FINANCIALJUICE_WSS_URL=wss://example.fj/ws
TREENEWS_WEBHOOK_TOKEN=__SET_ME__

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ───── 6. 可选：飞书/邮件通知（与 demo 无关） ───────────────
# FEISHU_WEBHOOK_URL=
# ALERT_EMAIL_TO=

# ───── 7. v300 反爬虫（默认全开） ─────────────────────────
# 投资者 portal 必备保护。会员机制上线后必须保持开。
# 默认开；要关显式设 "0"。不设 = 开。
TRIDENT_ANTI_BOT=1
TRIDENT_HONEYPOT=1
TRIDENT_WATERMARK_V2=1
TRIDENT_DATA_POISON=1
TRIDENT_DATA_POISON_PCT=0.03            # ±3% 噪声（爬到也训练不了）
TRIDENT_CHALLENGE_SECRET=__SET_ME__     # 32 字节随机
TRIDENT_WATERMARK_SECRET=__SET_ME__     # 32 字节随机

# Cloudflare Turnstile（前端反爬虫）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # 测试 key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  # 测试 key

# ───── 8. v300+ 反思系统阈值（可调） ─────────────────────────
# 收敛停：信号近 window 内分类熵低于此即认为"已稳定"，允许早停
META_MAX_ENTROPY=0.85
# 改判率：相邻两层 kind 分布距离低于此即认为"无新信息"
META_MIN_CHANGE=0.05

# "今日信号"新鲜度窗口（小时）：仅统计最近 N 小时 BUY/SELL。
# LLM/数据源全挂时如实归零（不靠早上 stale 单撑场）；设 0 = 关掉过滤。
FRESH_SIGNAL_HOURS=4

# Causal-Graph 守护（causal_graph_guard.py）
CAUSAL_MAX_DIFF_FRAC=0.20                # 行列漂移 > 20% 触发回滚
CAUSAL_HARD_LIMIT=0.50                   # 单格 > 50% 变化触发回滚

# 三轨裁决（jury.py）：confidence / quorum 阈值
JURY_MIN_CONFIDENCE=0.20                 # 单票 confidence < 此值被过滤
JURY_MIN_QUORUM=2                        # 至少 2 票才计 verdict

# 水印透明化：reflection_cycles.source_kind 默认值
# live / demo / stress_test / replay；demo_mode 会自动覆盖为 'demo'
REFLECTION_SOURCE_KIND_DEFAULT=live

# ───── 多证据闸门 / 交易闸门（v316 审计补齐，此前只有 .env 有、模板缺） ─────────
# 统一置信度闸门。config.py 的代码默认值是 10；本项一旦显式设置即覆盖代码默认值。
# 历史投影（config.py 注释记载）：40 → 0% 通过；20 → 2/169 通过、PnL +0.2%、胜率 50%；
#   10 → 让"有方向性但被卡住"的样本可评估为可操作，标注为"待 weekly_reflection 复跑验证"。
EVIDENCE_CONFIDENCE_GATE=20

# SELL 闸门无条件拒签的资产清单（逗号分隔）。
# 注意：不要与 SIM_ALLOWED_ASSETS 冲突 —— 同一资产既在白名单又被拒签，
#   等于该资产只能单向交易（WTI 曾在两边同时出现，导致 WTI 的 SELL 100% 被拒签）。
SELL_GATE_BLOCKED_ASSETS=BTC

# quick-sim 允许建仓的资产（逗号分隔）。
SIM_ALLOWED_ASSETS=XAU,WTI


# ───── Crowd Pulse：二级市场人群画像 / 权威度 / 月榜（v316 新增） ─────────────
# 数据全部来自真实抓取（百度热搜·实时/财经榜、同花顺热门股榜、CoinGecko 趋势、
# Google News RSS），每条原始条目带 url 可回溯，不做占位/编造填充。
# 总开关：0/false/no/off 关闭采集
CROWD_PULSE_ENABLED=1

# 参与采集的源（逗号分隔）
#   baidu_hot=百度热搜·实时榜  baidu_finance=百度热搜·财经榜
#   ths_hot=同花顺热门股榜     coingecko=CoinGecko 趋势
#   gnews=Google News RSS（财经媒体）
CROWD_PULSE_SOURCES=baidu_hot,baidu_finance,ths_hot,coingecko,gnews

# 采集间隔（分钟）
CROWD_PULSE_INTERVAL_MINUTES=60

# Google News RSS 检索式（决定"财经媒体在讨论什么"）
CROWD_PULSE_GNEWS_QUERY=股市 OR 美股 OR A股

# 榜单返回条数上限
CROWD_PULSE_TOP_N=50

# 单次 HTTP 超时（秒）
CROWD_PULSE_HTTP_TIMEOUT=15

# ── v321.3 P1: 出网代理 (需求 #6 挂单量/资金流 · 需求 #14 外部源) ─────────────
# 实测: 本机 VPN 是 IPv6-only TUN → 对 Binance / Yahoo / FRED (需要 IPv4) 无效。
# 代理模式的客户端会开一个**本地 HTTP/SOCKS 端口**, 填到这里即可全局生效。
#
# ⚠️ launchd 拉起的进程**不继承 shell 的环境变量** —— 填完 .env 后必须
#    `launchctl kickstart -k gui/$(id -u)/com.trident.{api,bridge,engine}` 重启,
#    只在终端里 export 是不生效的。
#
# 填了之后能立刻通的源 (实测): Binance 现货/合约 · Yahoo Finance · FRED ·
# Coinglass 付费接口 —— 归因页的**挂单量 + 资金费率**就能拿到真数据,
# 不再需要 macro_snapshots 里的等价替代源。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890      # SOCKS 需安装 requests[socks]


# ── v324: 本地 Ollama 兜底通道的三个开关 (互相联动, 别只改一个) ─────────────
#
# 背景 (2026-11-10 实测): 10 个远程 LLM 通道全部 quota_exhausted, 实时决策链停摆
# 30.8 小时 (ai_decisions 最后一条 2026-11-09 05:04) → 归因 AI 复核 97% 失败
# → 交易决策产出骤降 → 策略反思"样本不足 27<30" 一直卡住。
#
# 本地通道实测**是好的**: ollama /v1/chat/completions HTTP 200
# (qwen2.5:3b, 热态 1.4~2.3s, 冷启 7.8s; 门卫 L3 长 prompt 实测 27~30s)。
# 它没被用上, 是因为下面两个开关默认是"保守值":
#
#   1) GATE_LOCAL_FIRST=0  → 门卫不先打本地, 只在远程全熔断后才 fallback
#   2) GATE_LOCAL_TIMEOUT_S=8 → 本地等待上限 8s, 而 L3 门卫要 27~30s → 必然超时
#
# ⚠️ 原始顾虑 (2026-11-04): 本机 8GB 内存 + swap, 加载 1.9GB 的 qwen2.5-coder:7b
#    后纯推理 90s 不返回, 会拖死 ingest。3B 模型 (qwen2.5:3b) 无此问题。
#
# 要让本地真正接管 (建议在远程通道全废、且内存空闲 >3GB 时):
#   GATE_LOCAL_FIRST=1
#   GATE_LOCAL_TIMEOUT_S=45          # 覆盖 L3 门卫实测 27~30s (urllib 的 timeout
#                                    # 是**每段 socket 操作**上限, 实际总耗时 ≈ 3~4 倍)
#   LOCAL_LLM_MAIN_ENABLED=1         # ⚠️ 仅在装了 qwen2.5-coder:7b 及以上时开;
#                                    #    3B 做主分析质量不够, 只建议跑 gate/advisor
#
# 改完必须重启: launchctl kickstart -k gui/$(id -u)/com.trident.engine
# GATE_LOCAL_FIRST=0
# GATE_LOCAL_TIMEOUT_S=8
# LOCAL_LLM_MAIN_ENABLED=0

# ── v444（2026-11-18，用户定策）：通道恢复后**不补历史新闻** ───────────────────
# 规则：LLM 通道断过档、恢复之后，只分析"恢复时刻之后进来的"新闻；
#       断档期间积压的旧闻一律不分析（归档留痕 filter_reason=pre_recovery_skip）。
# 原因：额度是唯一稀缺资源。断档 5 小时积 200+ 条，补历史会把额度烧光，
#       新新闻反而排不上队（2026-11-18 实测）。旧闻已错失 45 分钟建仓窗口，
#       分析出来也换不成成交。
#
# 1 = 启用（生产默认）；0 = 关闭（只有重放历史做回归时才这么设）
NEWS_SKIP_BACKLOG_ON_RECOVERY=1
# 断档判定阈值（分钟）：主分析连续多久没有一次**成功**调用就算断过档。
# 正常态下 purpose='main' 的成功调用中位间隔 0.5 分钟；一个分析批次 6 条
# 要 8–21 分钟。15 分钟能容忍慢批次，又能第一时间认出真停摆。0 = 关闭判定。
NEWS_RECOVERY_GAP_MIN=15
# 水位状态文件（跨进程共享，只前进不后退）。默认 backend/runtime/news_cutoff.json
# NEWS_CUTOFF_STATE_PATH=

# ── v463 · 执行层组合闸（同品种重复开仓 / 杠杆上限 / 开仓止损） ───────────
DUP_ENTRY_GUARD=enforce
ALLOW_HEDGE=0
MAX_ASSET_WEIGHT_PCT=50
MAX_GROSS_LEVERAGE_PCT=100
PORTFOLIO_GUARD_MIN_USDT=100
AUTO_STOP_ENABLED=1
AUTO_STOP_PCT=2.0

# ── v493 · FinancialJuice 数据源登录态 Cookie（会话态，会过期；勿提交仓库） ──
# 留空 = 匿名抓取，可能被服务端踢线；过期后从浏览器登录态复制整串 Cookie 填入。
# FJ_COOKIE=
