    <key>Label</key>
    <string>com.trident.retention-prune</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/claire/Desktop/金融1.0/backend/cron/run_retention_prune.sh</string>
    </array>

    <!-- 每天 05:20（避开 04:00 kg_review / 04:10 causal_expand / 04:30 kg_reconcile） -->
