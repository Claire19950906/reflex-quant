        <integer>20</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/claire/Desktop/金融1.0/backend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/claire</string>
        <key>RETENTION_APPLY</key>
        <string>0</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/claire/Desktop/金融1.0/backend/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/claire/Desktop/金融1.0/backend/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
