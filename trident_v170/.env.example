# ============================================================
# Trident Agent MVP — Environment Variables
# ============================================================
# config.py 固定读取 backend/.env；请将本文件复制到 backend/.env：
#   copy .env.example backend\.env
# ============================================================

# ── Aiping（新闻主模型 + Data Copilot）──────────────────────
AIPING_API_KEY=
AIPING_BASE_URL=https://www.aiping.cn/api/v1
AIPING_MODEL=DeepSeek-V4-Flash-0731

# ── File Upload (Agent Chat 附件上传) ──────────────────────────
# 文件保存到项目根目录下的 backend/uploads/，默认即可
# UPLOAD_DIR=C:\absolute\path\to\uploads

# ── OpenRouter（仅 webhook 翻译与 realtime_filter 使用）──────
OPENROUTER_API_KEY=

# ── MiniMax 备用模型（可选）────────────────────────────────
# OpenRouter 余额不足(402)/不可用时，AI 分析自动切换用 MiniMax（权重不变，余额恢复自动切回）
# 免费申请：platform.minimax.chat（国内版）或 platform.minimaxi.com（国际版）
MINIMAX_API_KEY=
# 国内版 api.minimax.chat / 国际版 api.minimaxi.com
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01
# MiniMax 是否走代理（国内版直连更快设 false；国际版/受限网络设 true）
MINIMAX_USE_PROXY=true

# ── DeepSeek（仅 webhook 翻译直连候选）──────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── xAI / Grok (备用) ────────────────────────────────────────
XAI_API_KEY=

# ── Doubao (火山引擎，已暂停) ──────────────────────────────
DOUBAO_API_KEY=
DOUBAO_MODEL=ep-your-endpoint-id
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── MetaTrader 5 (可选) ────────────────────────────────────
# MT5_LOGIN=your_mt5_account
# MT5_PASSWORD=your_mt5_password
# MT5_SERVER=your_mt5_broker_server

# ── Binance Futures 自动交易 ───────────────────────────────
# 警告：BINANCE_USE_TESTNET 默认 false，即实盘交易；启用前请确认账户和风控。
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=false
# 修复：F1 — 与 config.py:103 默认值保持一致（5000 USDT）。原值 30 是早期模板残留，会让复制 .env.example 启动时与代码默认值不一致。
BINANCE_NOTIONAL_USDT=5000
BINANCE_LEVERAGE=5
BINANCE_SIGNAL_THRESHOLD=0.5
BINANCE_TRAILING_CALLBACK_RATE=0.5
BINANCE_NEWS_API_URL=http://127.0.0.1:8000/api/trading/latest
BINANCE_POLL_INTERVAL=2
BINANCE_REQUEST_TIMEOUT=5
# 以下路径可留空使用项目根目录默认绝对路径；如设置，请填写绝对路径
# BINANCE_STATE_PATH=C:\absolute\path\latest_news.json
# BINANCE_LOG_PATH=C:\absolute\path\news_trading.log
# 非空时管理 API 要求请求头 X-Trading-Token
TRADING_MANAGER_TOKEN=

# ── Trade Executor (v190 / EXCHANGE_INTEGRATION.md) ─────────────
# 引擎内 trade_executor worker 启动模式
#   off       - 完全关闭（默认）
#   paper     - 模拟模式：写 trade_audit_log 并标记 ai_decisions.entry_price，
#               不与 Binance 通信（生产回测环境推荐）
#   live_dry  - 连真实 Binance API 但只做只读（账户/行情/挂单），不下单
#   live_real - 真实下单；强烈建议先 live_dry 跑至少 1 个交易日
# 切换：POST /api/v190/exchange/mode/start {"mode": "..."} 实时生效
TRADE_EXECUTOR_MODE=off
TRADE_EXECUTOR_POLL_INTERVAL=5
MAX_POSITION_USDT=5000
WHITELIST_ASSETS=*

# ── Network Proxy (可选，仅 OpenRouter 相关调用) ────────────
HTTP_PROXY=http://127.0.0.1:10808

# ── TreeNews Bridge (可选) ──────────────────────────────────
TREE_NEWS_PORT=9000

# ── 动态新闻源与模拟账户 ─────────────────────────────────────
TECHFLOW_NEWS_URL=https://www.techflowpost.com/api/client/newsflashes?page=1&page_size=50
EASTMONEY_NEWS_URL=https://np-listapi.eastmoney.com/comm/web/getNewsByColumns?client=web&biz=web_news_col&column=345&order=1&needInteractData=0&page_index=1&page_size=50
BLOCKBEATS_NEWS_URL=https://api.theblockbeats.news/v1/open-api/open-flash?size=50&page=1&type=push&lang=cn
# 外部新闻源轮询间隔（秒）：默认 10s；设 5s 需谨慎（3 个源并发 + 每日配额占用加速）
NEWS_SOURCE_POLL_SECONDS=10
NEWS_SOURCE_PAGES=6
EVENTS_LIST_MAX=10000
PAPER_INITIAL_EQUITY_USDT=10000

# ── AI 分析批量参数（批量新闻多时优化吞吐） ────────────────
# 每批分析条数：越小单批消化越快（10 条一批约 15-20s；15 条约 30s）
AI_BATCH_SIZE=10

# ── Hermes 多 agent 写作驱动 ────────────────────────────────
# 分席写作 + 已结算技能回灌；关闭后仍走原单模型 14 字段决策
HERMES_AGENT_ENABLED=1
HERMES_SKILL_MIN_SAMPLE=8

# ── 非新闻数据层 ──────────────────────────────────────────
# 盘面结构 / 舆情情绪 / 美联储预期 / 资金流向
MACRO_CONTEXT_ENABLED=1
# 可选：SoSoValue 或同类 BTC ETF 日净流入 JSON；留空则该指标标 unavailable
SOSOVALUE_ETF_URL=

# ── FRED｜美联储官方(原始宏观数据 API) ─────────────────────────────────────
# 无新闻快讯，仅 CPI/非农/利率/M2/美债等官方原始统计数据：
#  - 作为宏观背景喂给 AI 分析（macro_context 的 fred 层）
#  - 新数据发布 / 显著趋势变化时生成事件进新闻流，触发 AI 分析与模拟盘交易
# 免费申请 Key：https://fred.stlouisfed.org/docs/api/api_key.html
# 留空则 FRED 层标 unavailable、不生成事件，不影响其他功能
FRED_API_KEY=
# 发布事件影响分级：high=仅 CPI/非农/利率/美债等即时影响行情的指标生成事件（默认，推荐）；
# all=所有指标（含 M2 等滞后月度数据）都生成事件，可能刷屏
FRED_EVENT_IMPACT=high
# 数据发布检测轮询间隔（秒）：默认 60s，独立于普通新闻源轮询。
# FRED 免费 Key 限速 120 次/分钟；FRED 数据更新滞后官方发布数小时不定
# （中转源），60s 检测延迟远小于其自身更新滞后，比 10s 省 6 倍请求。
FRED_POLL_SECONDS=60

# ── BLS｜美国劳工统计局(CPI/非农原始发布) ─────────────────────
# 官方原始数据源：CPI/核心CPI/非农/失业率等一手发布（比 FRED 更接近发布时刻）。
# 免费申请 Key：https://data.bls.gov/registrationEngine/ （注册后邮箱收 key，格式 XXXX-XXXX-XXXX-XXXX）
# 接口：POST https://api.bls.gov/publicAPI/v2/timeseries/data/ （v2 免费 25 次/日/500 series）
# 留空则 BLS 层标 unavailable、不生成事件，不影响其他功能
BLS_API_KEY=
# BLS 发布检测轮询间隔（秒）：v2 免费仅 25 次请求/日 → 默认 3600s（1 小时一次，
# 每日 24 次请求刚好不超配额）。配了更高档位 key 可调小（如 600）。
BLS_POLL_SECONDS=3600

# ── Reuters 路透（Google News RSS 聚合通道）──────────────
# ⚠️ 已停用：Google News 收录路透滞后 ~2h（实测平均 118min），对交易信号
# 时效无价值，且与金十（秒级转发路透一手）内容重复占 AI 配额。
# 路透时效由金十快讯承担。置 0 关闭（watcher 启动即跳过）。
REUTERS_NEWS_ENABLED=0
REUTERS_NEWS_POLL_SECONDS=60

# ── 金十数据 MCP（快讯/行情/财经日历）────────────────────────
# 端点：https://mcp.jin10.com/mcp（SSE 流式 JSON-RPC，Bearer token 鉴权）
# 免费体验 token 在 https://mcp.jin10.com/app/ 申请；买会员后同端点、token 权限升级。
# 支持多 token 轮换：逗号分隔，某个 token 当日配额用完自动切下一个（如：
#   JIN10_MCP_TOKEN=sk-aaa,sk-bbb,sk-ccc
# 留空则金十自动降级为 SSR 首页 HTML 解析（jin10.com 已改 CSR，大概率不可用）
JIN10_MCP_TOKEN=
# 留空默认官方端点
# JIN10_MCP_URL=https://mcp.jin10.com/mcp
# 快讯采集轮询间隔（秒）：默认 10s，金十有独立高频 watcher；免费 token 触发 429 可调大
JIN10_MCP_POLL_SECONDS=10
# 日历公布检测轮询间隔（秒）：默认 30s；公布后进实时信号台 + AI 分析的延迟 ≤ 此值
JIN10_CALENDAR_POLL_SECONDS=30
# 日历星级门槛（1/2/3）：2=PMI/GDP 及以上（推荐）；3=仅 CPI/非农/利率；1=全量小数据
JIN10_CALENDAR_MIN_STAR=2

# ── 快速模拟评测 (盈利率评测通道) ────────────────────────────
# 全部 BUY/SELL 信号按真实行情建仓，短周期结算；不影响正式模拟盘闸门
QUICK_SIM_ENABLED=1
# 模拟持仓最长持有多久（分钟）后强制结算。
# 注意：时长在建仓时写入每笔记录，改这里只影响之后新开的仓；
#       已建仓的仍按各自记录里的时长结算，不会被追溯改动。
QUICK_SIM_HORIZON_MINUTES=20
QUICK_SIM_NOTIONAL_USDT=100
QUICK_SIM_POLL_SECONDS=15

# ── AI 复盘经验回灌 (review_insights → prompt) ───────────────
# 启用的经验会以独立分区「═══ 复盘经验 ═══」注入每次 AI 分析的 prompt。
# 条数由你在复盘页 / 提示库页逐条启用、停用控制，默认不限：
#   0 = 不限制（启用多少注入多少，默认。停用的经验本来就不注入，无需靠上限收敛）
#   改成 20/30 之类可主动收敛 prompt 体积。
# 体积参考：102 条约 2279 字（≈1500 token，占 Prompt Force 的 29%）；20 条约 614 字。
REVIEW_INSIGHTS_LIMIT=0
# 最少样本数门槛：样本太少（<5）的经验不可靠，不注入。
REVIEW_INSIGHTS_MIN_SAMPLES=5

# ── v231+ meta_reflection_loop 阈值（可离线校准）─────────────────────
# 这 4 个值原是 meta_reflection_loop.py 里的 magic number；现挪到 config.py。
# 如要重新校准，跑 reflection_calibration.py 生成 docs/CALIBRATION_REPORT.md。
# 默认值与 v170 内联常量保持一致。
META_WR_DELTA=0.15
# WR 变化幅度达此值视为 refined / invalidated（v170 默认 0.15）
META_CONFIRM_BAND=0.05
# WR 稳定带宽（v170 默认 0.05）
META_MIN_SAMPLES=5
# meta-loop 最低样本数（v170 默认 5）
META_LUCK_THRESHOLD=0.30
# luck 视为运气主导的门槛（v170 默认 0.30）

# ── v231+ meta-loop 自适应深度 ───────────────────────────────
# 旧逻辑写死 max_level=2；现改用"信息增益"规则自动停止。
# 规则：下一层 finding_kind 与上一层 < META_STOPPING_EPS 比例变化
#       + 当前层熵 < META_MAX_ENTROPY 才继续；否则停在当前层。
META_MAX_LEVEL=4
# 硬上限（v170 默认 2；新规则下建议 3-4）
META_STOPPING_EPS=0.05
# 最小改判率（< eps 视为没新信息，停）
META_MAX_ENTROPY=0.85
# 最大允许层内熵（> 视为震荡，停）

# ── v231+ causal_graph_guard 阈值（causal_graph.py 自动更新回滚保护）────
# causal_graph_guard.py 暴露 snapshot → diff → 回滚 机制。
# 调小 → 更保守（更容易回滚）；调大 → 容忍更多漂移。
CAUSAL_MAX_DIFF_FRAC=0.20
# 行列漂移超过此比例触发回滚
CAUSAL_HARD_LIMIT=0.50
# 任意单格相对变化超过此比例触发回滚（防一格毒害全表）
# ── 经验的自动启停评估（按命中归因，双向可恢复）───────────────
# 引擎用 ai_decisions.insight_hit_ids（建仓时记录"本条命中了哪几条经验"）
# 逐条统计"命中该经验的交易"胜率，据此启停：
#   · 样本 ≥ INSIGHT_MIN_SAMPLE 且命中胜率 < INSIGHT_DEACTIVATE_WINRATE → 自动停用
#   · 已停用经验命中胜率回升 ≥ INSIGHT_REACTIVATE_WINRATE → 自动恢复启用
#   · 样本不足的经验不动（不会因为"没数据"就被停用）
# 旧逻辑用"全局胜率"判断单条经验（归因不成立），曾一次性停用全部经验且不可恢复。
INSIGHT_MIN_SAMPLE=10
INSIGHT_DEACTIVATE_WINRATE=0.35
INSIGHT_REACTIVATE_WINRATE=0.55

# ── 飞书告警 (可选) ─────────────────────────────────────────
# 交易信号推送到飞书群机器人；留空则引擎只打印一次警告并跳过发送
FEISHU_WEBHOOK_URL=

# ── CORS 白名单 (可选) ──────────────────────────────────────
# 逗号分隔的允许来源列表，默认为本地开发端口
# CORS_ALLOW_ORIGINS=http://localhost:3030,http://127.0.0.1:3030
# 新闻写库后内部 SSE 增量检测周期，单位毫秒；建议 20-1000
NEWS_WATCH_INTERVAL_MS=50

# ── 火山方舟 (Volcengine Ark) 分析通道 ─────────────────────
# 本机 .env 里填真实值, 切勿写进本模板或代码: 模型 endpoint id 会被
# GitHub Push Protection 误判为 API Key 而拦截整个 push
# 三项都为空时该通道自动跳过, 不影响其它模型
ARK_API_KEY=
ARK_MODEL=
ARK_ENABLED=1

# ── Frontend (Next.js) ─────────────────────────────────────
# 在 frontend/.env.local 中设置:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
