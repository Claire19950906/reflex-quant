<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Label: launchd 唯一标识，必须与文件名一致 -->
    <key>Label</key>
    <string>com.trident.weekly_reflection</string>

    <!-- ProgramArguments: 启动命令 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/claire/.cline/data/workspaces/chat/trident_v170/backend/cron/run_weekly_reflection.sh</string>
    </array>

    <!-- StartCalendarInterval: 定时规则
         Weekday 字段：0 和 7 都是周日，1=周一, 2=周二 ... 6=周六
         （参考 crontab 约定 + launchd 文档 "0 and 7 are Sunday"）
         Weekday=1 = 周一
         Hour=9, Minute=0 = 09:00 触发 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- WorkingDirectory: 工作目录 -->
    <key>WorkingDirectory</key>
    <string>/Users/claire/.cline/data/workspaces/chat/trident_v170/backend</string>

    <!-- EnvironmentVariables: 必须显式注入 PATH（launchd 默认 PATH 很窄） -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/claire</string>
    </dict>

    <!-- StandardOutPath / StandardErrorPath: 输出到 launchd 日志 -->
    <key>StandardOutPath</key>
    <string>/Users/claire/.cline/data/workspaces/chat/trident_v170/backend/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/claire/.cline/data/workspaces/chat/trident_v170/backend/logs/launchd.err.log</string>

    <!-- RunAtLoad: 加载时立即跑一次（方便测试） -->
    <key>RunAtLoad</key>
    <false/>

    <!-- KeepAlive: 不重试（避免一次失败反复跑）-->
    <key>KeepAlive</key>
    <false/>

    <!-- ProcessType: Background -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
