# =============================================================
# Trident v300 — 环境变量模板
# =============================================================
# 用法：cp backend/.env.example backend/.env，然后填入真实值。
# 切勿把 .env 提交到 Git（.gitignore 已忽略）。
# =============================================================

# ───── 1. 运行模式（v300 新增） ─────────────────────────────
# full    = 开发者本地全功能模式（默认）
# demo    = 公开/朋友体验模式：限流 + 脱敏 + 水印 + 审计
# licensed= 受邀请用户体验：full + License + API Key
TRIDENT_MODE=full

# full 模式下的监听地址（默认 127.0.0.1；改成 0.0.0.0 会启动告警）
TRIDENT_LISTEN_HOST=127.0.0.1
TRIDENT_LISTEN_PORT=8000

# ───── 2. 体验模式（demo）参数 ─────────────────────────────
TRIDENT_DEMO_RPM=30                   # 每 IP 每 60s 最多 30 次
TRIDENT_DEMO_DAILY_BUDGET=5000        # 每 IP 每天最多 5000 次
TRIDENT_DEMO_DELAY_MS=200             # 注入 200ms 延迟
TRIDENT_DEMO_JITTER_MS=80             # ±80ms 抖动
TRIDENT_DEMO_HISTORY_DAYS=1           # 历史窗口
TRIDENT_DEMO_DECIMALS=2               # 数值截位
TRIDENT_DEMO_TOKEN_BUDGET=100000      # 全局每日 token 上限

# ───── 3. 鉴权（licensed 模式必填） ────────────────────────
# 32 字节随机；漏设 = load_license 直接返回 None（fail-closed）
TRIDENT_LICENSE_SECRET=__SET_ME__
TRIDENT_LICENSE_FILE=/etc/trident/license.lic
TRIDENT_API_KEY_STORE=/etc/trident/api_keys.json

# licensed 模式覆盖默认值（更宽松）：
# TRIDENT_DEMO_RPM=120
# TRIDENT_DEMO_DAILY_BUDGET=50000
# TRIDENT_DEMO_HISTORY_DAYS=7
# TRIDENT_DEMO_DECIMALS=4

# ───── 4. 审计（demo / licensed 模式启用） ──────────────────
TRIDENT_AUDIT_DB=/var/lib/trident/trident_audit.db

# ───── 5. 业务侧原有变量（保持兼容） ────────────────────────
# LLM（OpenRouter / Kimi）
OPENROUTER_API_KEY=__SET_ME__
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TRIDENT_LLM_MODEL=moonshotai/kimi-k2

# 数据源
FINANCIALJUICE_WSS_URL=wss://example.fj/ws
TREENEWS_WEBHOOK_TOKEN=__SET_ME__

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ───── 6. 可选：飞书/邮件通知（与 demo 无关） ───────────────
# FEISHU_WEBHOOK_URL=
# ALERT_EMAIL_TO=

# ───── 7. v300 反爬虫（默认全开） ─────────────────────────
# 投资者 portal 必备保护。会员机制上线后必须保持开。
# 默认开；要关显式设 "0"。不设 = 开。
TRIDENT_ANTI_BOT=1
TRIDENT_HONEYPOT=1
TRIDENT_WATERMARK_V2=1
TRIDENT_DATA_POISON=1
TRIDENT_DATA_POISON_PCT=0.03            # ±3% 噪声（爬到也训练不了）
TRIDENT_CHALLENGE_SECRET=__SET_ME__     # 32 字节随机
TRIDENT_WATERMARK_SECRET=__SET_ME__     # 32 字节随机

# Cloudflare Turnstile（前端反爬虫）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # 测试 key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  # 测试 key

# ───── 8. v300+ 反思系统阈值（可调） ─────────────────────────
# 收敛停：信号近 window 内分类熵低于此即认为"已稳定"，允许早停
META_MAX_ENTROPY=0.85
# 改判率：相邻两层 kind 分布距离低于此即认为"无新信息"
META_MIN_CHANGE=0.05

# "今日信号"新鲜度窗口（小时）：仅统计最近 N 小时 BUY/SELL。
# LLM/数据源全挂时如实归零（不靠早上 stale 单撑场）；设 0 = 关掉过滤。
FRESH_SIGNAL_HOURS=4

# Causal-Graph 守护（causal_graph_guard.py）
CAUSAL_MAX_DIFF_FRAC=0.20                # 行列漂移 > 20% 触发回滚
CAUSAL_HARD_LIMIT=0.50                   # 单格 > 50% 变化触发回滚

# 三轨裁决（jury.py）：confidence / quorum 阈值
JURY_MIN_CONFIDENCE=0.20                 # 单票 confidence < 此值被过滤
JURY_MIN_QUORUM=2                        # 至少 2 票才计 verdict

# 水印透明化：reflection_cycles.source_kind 默认值
# live / demo / stress_test / replay；demo_mode 会自动覆盖为 'demo'
REFLECTION_SOURCE_KIND_DEFAULT=live

