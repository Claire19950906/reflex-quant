# ============================================================
# Trident Agent MVP — .gitignore
# ============================================================
# 量化交易系统 / 实盘交易 / API 密钥 / 数据库 / 构建产物
# ============================================================

# ── Secrets & Environment ──────────────────────────────────
# 包含 Binance API Key、大模型 Key (OpenRouter/DeepSeek/Doubao/XAI)、MT5 凭证
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 防止误提交任何包含 "secret" / "credential" / "key" 的配置文件
*secret*
*credential*
*private*

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl
*.manifest
*.spec

# Virtual environments
venv/
.venv/
env/
env.bak/
ENV/

# pip / pipenv
Pipfile.lock
pip-delete-this-directory.txt

# ── Node.js / Next.js ──────────────────────────────────────
node_modules/
.next/
*.tsbuildinfo
next-env.d.ts
out/
# 前端解析逻辑验证脚本的编译产物（scripts/verify_asset_split.mjs 生成）
.verify_out/

# ── Databases (CRITICAL) ───────────────────────────────────
# 存储动态 ATR 止损止盈参数和实盘交易账单，绝对不可泄露
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
# 数据库备份/快照变体 (如 trident_event_bus.db.bak_pre_restore_20261021)
*.db.*
*.db-*

# ChromaDB 向量存储（Hermes Research Agent 运行时数据）
chroma_data/

# ── MetaTrader 5 ───────────────────────────────────────────
# MT5 本地终端日志、缓存、配置
MQL5/
mt5_*.log
MT5_*.log
*.mt5log
terminal*.log
tester*.log
*.mqlcache

# ── Backup / Temp / Broken ─────────────────────────────────
*.bak
*.broken
*.tmp
*.temp
*.orig
*~
*.swp
*.swo
*.swn
*.old

# ── AI 审计/诊断临时脚本 (一次性产物, 不属于项目源码) ──
backend/src_python/_*.py
backend/src_python/gub_capability_audit.py

# ── IDE / Editor ───────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.history/
*.iml

# ── OS ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Excel Lock Files ───────────────────────────────────────
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx
~$*.xlsm

# ── Generated / Export / Data ──────────────────────────────
dashboard/*.xlsx
!dashboard/*_sample.xlsx
*.csv

# 模拟盘一键重置的自动备份（JSON + Excel 留档）
backend/backups/
# 运行时上传产物 (每次运行生成, 非源码)
backend/uploads/

# ── Media / Large Binaries ─────────────────────────────────
*.mp4
*.mp3
*.mov
*.avi
*.webm
*.wav
*.flac
*.zip
*.tar.gz
*.rar
*.7z
*.pdf

# ── Test / Coverage ────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover

# ── Docker ─────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── Logs ───────────────────────────────────────────────────
*.log
logs/

# ── Misc ───────────────────────────────────────────────────
# macOS resource fork
*.rsrc

# Memory files (runtime state)
.memory/
