# ============================================================
# Trident Agent MVP — .gitignore
# ============================================================
# 量化交易系统 / 实盘交易 / API 密钥 / 数据库 / 构建产物
# ============================================================

# ── Secrets & Environment ──────────────────────────────────
# 包含 Binance API Key、大模型 Key (OpenRouter/DeepSeek/Doubao/XAI)、MT5 凭证
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 防止误提交任何包含 "secret" / "credential" / "key" 的配置文件
*secret*
*credential*
*private*
.trident_keys.json
*.lic
# 调试残留临时 json（f.json / p.json 等单字母文件）
/backend/src_python/?.json
/frontend/?.json

# ── Python ─────────────────────────────────────────────────
__pycache__/
__pycache__ */
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl
*.manifest
*.spec

# Virtual environments
venv/
.venv/
env/
env.bak/
ENV/

# pip / pipenv
Pipfile.lock
pip-delete-this-directory.txt

# ── Node.js / Next.js ──────────────────────────────────────
node_modules/
.next/
# v311: 生产构建独立产物目录(NEXT_DIST_DIR=.next-prod), 与 dev 的 .next 并存
.next-prod/
# 历史/旧版构建产物目录（.next-prod.old / .old2 / .broken 等），均不入库
.next-prod.old*/
.next-prod.broken*/
frontend/.next-prod.old*/
frontend/.next-prod.broken*/
*.tsbuildinfo
next-env.d.ts
out/
# 前端解析逻辑验证脚本的编译产物（scripts/verify_asset_split.mjs 生成）
.verify_out/

# ── Databases (CRITICAL) ───────────────────────────────────
# 存储动态 ATR 止损止盈参数和实盘交易账单，绝对不可泄露
*.db
# 演示库是例外：合成数据，故意入库，让 clone 后开箱有界面可看
!backend/demo.db
backend/demo.db-wal
backend/demo.db-shm
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal

# ChromaDB 向量存储（Hermes Research Agent 运行时数据）
chroma_data/

# ── MetaTrader 5 ───────────────────────────────────────────
# MT5 本地终端日志、缓存、配置
MQL5/
mt5_*.log
MT5_*.log
*.mt5log
terminal*.log
tester*.log
*.mqlcache

# ── Backup / Temp / Broken ─────────────────────────────────
*.bak
*.bak-*
*.broken
*.tmp
*.temp
*.orig
*~
*.swp
*.swo
*.swn
*.old

# ── IDE / Editor ───────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.history/
*.iml

# ── OS ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Excel Lock Files ───────────────────────────────────────
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx
~$*.xlsm

# ── Generated / Export / Data ──────────────────────────────
dashboard/*.xlsx
!dashboard/*_sample.xlsx
*.csv

# 模拟盘一键重置的自动备份（JSON + Excel 留档）
backend/backups/
# 运行时 SQL 导出/临时备份目录（去重、回填前快照等），不入库
backend/backup/

# ── Media / Large Binaries ─────────────────────────────────
*.mp4
*.mp3
*.mov
*.avi
*.webm
*.wav
*.flac
*.zip
*.tar.gz
*.rar
*.7z
*.pdf

# ── Test / Coverage ────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover

# ── Docker ─────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── Logs ───────────────────────────────────────────────────
*.log
logs/

# ── Misc ───────────────────────────────────────────────────
# macOS resource fork
*.rsrc

# Memory files (runtime state)
.memory/

# ── 数据库衍生文件 (2026-10-27) ──────────────────────────────
# 形如 trident_event_bus.db.bak_ccstrategy_20261024_093141 / .db-wal / .db-shm
# 这类文件名带时间戳, 上面 *.db 与 *.bak 规则都盖不住, 单个 600MB+ —— 必须显式忽略,
# 否则 git add 会把整个数据库历史拖进版本库。
*.db.*
*.db-*
*.db.bak*
*.empty-shell.bak
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*

# ── 运行时产物 (2026-10-27) ─────────────────────────────────
# 新闻导出批次是运行时产物 (每次拉新闻生成一个目录), 不是源码, 不进版本库
backend/news_exports/
backend/runtime/
*.jsonl

# 数据库带时间戳备份（单文件 ~800MB，永不入库）
*.bak.*
backend/*.db*

# v340 提交前清理：运行时上传/临时产物/带时间戳备份
backend/uploads/
backend/work/
backend/src_python/runtime/
*.bak_*
backend/_dead_files_backup/

# 端到端/回归截图产物，不进版本库
.shots/

# audit 层回放产物（生成物，不入库）
audit_out/

# 演示库例外（合成数据，故意入库）：必须写在所有 *.db 规则之后
!backend/demo.db
