<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/YOUR_USER/android-runtime/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONIOENCODING</key>
		<string>utf-8</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>TRIDENT_BUSY_TIMEOUT_MS</key>
		<string>20000</string>
		<key>TRIDENT_NO_AUTO_SETUP</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.trident.engine</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/YOUR_USER/.trident/wrappers/run_engine.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USER/.trident/log/engine.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USER/.trident/log/engine.out.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USER</string>
</dict>
</plist>
