<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.trident.anomaly-archive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/claire/.trident/wrappers/run_anomaly_archive.sh</string>
  </array>
  <key>StartInterval</key><integer>21600</integer>
  <key>WorkingDirectory</key><string>/Users/claire/.trident</string>
  <key>StandardOutPath</key><string>/Users/claire/.trident/log/anomaly_archive.out.log</string>
  <key>StandardErrorPath</key><string>/Users/claire/.trident/log/anomaly_archive.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <key>PYTHONIOENCODING</key><string>utf-8</string>
    <key>TRIDENT_BUSY_TIMEOUT_MS</key><string>30000</string>
    <key>PATH</key><string>/Library/Frameworks/Python.framework/Versions/3.14/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
