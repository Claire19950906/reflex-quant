# EditorConfig — consistent coding style across editors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # markdown hard line breaks are intentional

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

# Markdown tables — preserve alignment
[*.{ts,js,json,html,css}]
indent_size = 2
