+        "cost_bps": round(cost_bps, 2),
+        "need_mfe_pct": round(need_pct, 4),
+        "median_mfe_pct": None if med is None else round(med, 4),
+        "samples": n,
+    }
+    if med is None:
+        return True, "edge_unverified", meta
+    if med < need_pct:
+        return False, f"cost_edge_insufficient({med:.3f}%<{need_pct:.3f}%)", meta
